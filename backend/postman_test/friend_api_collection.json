        {
          "name": "A Send Friend Request to B (should auto-accept)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Auto accept message', function () {",
                  "  const msg = (json.message || '').toLowerCase();",
                  "  pm.expect(msg.includes('tu dong') || msg.includes('tự động')).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessTokenA}}", "type": "text" },
