      "name": "0. Auth",
      "item": [
        {
          "name": "Signin User A",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "if (json.accessToken) pm.collectionVariables.set('accessTokenA', json.accessToken);",
                  "if (json.refreshToken) pm.collectionVariables.set('refreshTokenA', json.refreshToken);",
                  "if (json.user && json.user._id) pm.collectionVariables.set('userIdA', json.user._id);",
                  "",
                  "pm.collectionVariables.set('activeAccessToken', json.accessToken || '');",
                  "pm.collectionVariables.set('activeUserId', (json.user && json.user._id) || '');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{loginUsernameA}}\",\n  \"password\": \"{{loginPasswordA}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/backend/api/auth/signin",
              "host": ["{{baseUrl}}"],
              "path": ["backend", "api", "auth", "signin"]
            },
            "description": "Dang nhap User A. Tu dong luu accessTokenA/userIdA va set activeAccessToken = accessTokenA."
          },
          "response": []
        },
