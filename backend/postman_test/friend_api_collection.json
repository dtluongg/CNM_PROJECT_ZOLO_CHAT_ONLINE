        {
          "name": "My Blocked List Only (include blocked)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "const json = pm.response.json();",
                  "const data = Array.isArray(json.data) ? json.data : [];",
                  "const blocked = data.filter(x => x && (x.iBlocked === true || x.theyBlockedMe === true));",
                  "pm.collectionVariables.set('blockedList', JSON.stringify(blocked, null, 2));",
                  "console.log('Blocked list:', blocked);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{activeAccessToken}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/backend/api/friends/list?includeBlocked=true",
