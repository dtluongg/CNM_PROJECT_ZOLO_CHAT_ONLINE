            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"testuser\",\n  \"otp\": \"<NHAP_OTP_EMAIL_THUC_TE>\",\n  \"newPassword\": \"NewPass123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/backend/api/users/reset-password",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "backend",
            "api",
            "users",
            "reset-password"
          ]
        }
      },
      "response": []
    }
