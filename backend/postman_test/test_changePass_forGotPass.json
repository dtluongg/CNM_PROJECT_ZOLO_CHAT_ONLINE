{
  "info": {
    "name": "ZoloChat User Auth",
    "_postman_id": "a5c9b8d0-0000-0000-0000-000000000000",
    "description": "Collection test signup/signin/signout, change password, forgot/reset password cho ZoloChat backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Signup - Send Email OTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"testuser@example.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/backend/api/auth/send-email-otp",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "backend",
            "api",
            "auth",
            "send-email-otp"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Local Signup",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"Test1234\",\n  \"email\": \"testuser@example.com\",\n  \"firstName\": \"Test\",\n  \"lastName\": \"User\",\n  \"phone\": \"0901234567\",\n  \"emailOtp\": \"<NHAP_OTP_EMAIL_THUC_TE>\",\n  \"phoneOtp\": null\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/backend/api/users/signup",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "backend",
            "api",
            "users",
            "signup"
          ]
        }
      },
      "response": []
    },
    {
