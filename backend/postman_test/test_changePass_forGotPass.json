    {
      "name": "Refresh Access Token (Local)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/backend/api/users/refreshme",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "backend",
            "api",
            "users",
            "refreshme"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Change Password (Local, Logged In)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"oldPassword\": \"Test1234\",\n  \"newPassword\": \"NewPass123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/backend/api/users/change-password",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "backend",
            "api",
            "users",
            "change-password"
          ]
        }
      },
      "response": []
    },
    {
