{
  "expo": {
    "name": "Zolo Chat",
    "icon": "./public/logo.png",
    "slug": "chatapp-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chatapp.mobile"
    },
    "android": {
      "package": "com.chatapp.mobile"
    },
    "scheme": "chatapp",
    "experiments": {
      "typedRoutes": false
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép ứng dụng truy cập ảnh của bạn"
        }
      ],
      "expo-web-browser"
    ]
  }
}
